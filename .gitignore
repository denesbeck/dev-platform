# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Talos — generated machine configs and talosctl context contain cluster secrets;
# commit only SOPS-encrypted copies.
talos/controlplane.yaml
talos/worker.yaml
talos/talosconfig

# kubeconfig
kubeconfig
*.kubeconfig

# IRSA OIDC docs generated by terraform/06-s3.tf at apply
terraform/jwks.json
terraform/openid-configuration.json

# Helm dependencies vendored by `helm dependency build`. Chart.lock is committed
# (it pins the digest); the tarballs are refetched by CI and by Argo CD's
# repo-server, so they don't belong in Git.
argocd/**/charts/*.tgz
terraform/charts/**/charts/*.tgz

# SOPS / age
*.dec.yaml
*.dec.yml
keys.txt

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo
*~
